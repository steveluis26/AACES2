# AACES2 — production configuration (EXAMPLE)
# Copy to config/.env.production and fill with real secrets via your
# deployment environment / secrets manager.
# NEVER commit config/.env.production.

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/aaces_db
SECRET_KEY=change-me-to-a-secure-random-key
ENCRYPTION_KEY=change-me-to-a-secure-encryption-key
DEBUG=false
HOST=0.0.0.0
PORT=8000
APP_NAME=AACES
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=["https://your-domain.com"]
ALLOWED_HOSTS=["your-domain.com"]
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=change-me
FROM_EMAIL=no-reply@example.com
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/var/lib/aaces/uploads
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
MAX_VALIDATION_ATTEMPTS=5
VALIDATION_LOCKOUT_MINUTES=15
LOG_LEVEL=INFO
LOG_FILE=/var/log/aaces/app.log
AUDIT_LOG_FILE=/var/log/aaces/audit.log
SECURITY_HEADERS_ENABLED=true
FORCE_HTTPS=true
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
