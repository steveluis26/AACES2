# AACES - Sistema de Gestión de Capacitaciones
# Configuración de Base de Datos PostgreSQL - Producción

# Conexión a la base de datos (usar variables de entorno reales en producción)
DATABASE_URL=${DATABASE_URL}

# Configuración de seguridad (usar variables de entorno reales en producción)
SECRET_KEY=${SECRET_KEY}
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# Configuración de la aplicación
DEBUG=false
HOST=0.0.0.0
PORT=${PORT:-8000}
APP_NAME=AACES - Sistema de Gestión de Capacitaciones

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database pool configuration
DATABASE_POOL_SIZE=50
DATABASE_MAX_OVERFLOW=100

# Redis configuration (usar variables de entorno reales en producción)
REDIS_URL=${REDIS_URL}

# CORS configuration
ALLOWED_ORIGINS=${ALLOWED_ORIGINS}
ALLOWED_HOSTS=${ALLOWED_HOSTS}

# Email configuration (usar variables de entorno reales en producción)
SMTP_SERVER=${SMTP_SERVER}
SMTP_PORT=${SMTP_PORT}
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
FROM_EMAIL=${FROM_EMAIL}

# File upload configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Pagination configuration
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate limiting (más estricto en producción)
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# Validation settings
MAX_VALIDATION_ATTEMPTS=3
VALIDATION_LOCKOUT_MINUTES=60

# Logging
LOG_LEVEL=WARNING
LOG_FILE=/app/logs/aaces.log
AUDIT_LOG_FILE=/app/logs/audit.log

# Security headers
SECURITY_HEADERS_ENABLED=true
FORCE_HTTPS=true

# Database backup
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30