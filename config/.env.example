# AACES - Sistema de Gestión de Capacitaciones
# Configuración de Base de Datos PostgreSQL

# Conexión a la base de datos
DATABASE_URL=postgresql://aaces_user:aaces_password@localhost:5432/aaces_db

# Configuración de seguridad
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-32-characters-long
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data-32-bytes

# Configuración de la aplicación
DEBUG=true
HOST=0.0.0.0
PORT=8000
APP_NAME=AACES - Sistema de Gestión de Capacitaciones

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database pool configuration
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis configuration (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# CORS configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://aaces-frontend.vercel.app
ALLOWED_HOSTS=localhost,api.aaces.com

# Email configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@aaces.com

# File upload configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Pagination configuration
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Validation settings
MAX_VALIDATION_ATTEMPTS=5
VALIDATION_LOCKOUT_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/aaces.log
AUDIT_LOG_FILE=logs/audit.log