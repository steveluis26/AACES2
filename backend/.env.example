# AACES2 — backend local configuration (EXAMPLE)
# Copy to backend/.env and fill with your local values.
# NEVER commit backend/.env.

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aaces_db
DEBUG=false
HOST=0.0.0.0
PORT=8000
ALLOW_DEV_LOGIN=false
SECRET_KEY=change-me-to-a-secure-random-key
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
UPLOAD_DIR=/tmp/aaces_uploads
STORAGE_DIR=/tmp/aaces_storage
PUBLIC_VERIFICATION_URL=http://localhost:8000/verificar

# Platform / Demo credentials (Phase 1)
PLATFORM_USER_EMAIL=admin@aaces.com
PLATFORM_USER_PASSWORD=supersecurepassword123
PLATFORM_USER_NAME=Super Admin
DEMO_ORG_RFC=AAC123456789
DEMO_ORG_NAME=AACES Demo
DEMO_ORG_ADMIN_EMAIL=admin@demo.com
DEMO_ORG_ADMIN_PASSWORD=demo123
DEMO_ADMIN_NAME=Administrador
