# AACES Backend Configuration
DEBUG=true
HOST=0.0.0.0
PORT=8001
# ALLOW_DEV_LOGIN is not enabled in stable mode
# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/aaces_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis Configuration
REDIS_URL=redis://172.20.0.3:6379/0

# Security
SECRET_KEY=aaces-super-secret-key-change-in-production-for-security-reasons-2024
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@aaces.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Certificates
CERTIFICATE_TEMPLATE_DIR=./templates/certificates
CERTIFICATE_VALIDITY_DAYS=1095

# Security Settings
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# Audit
AUDIT_RETENTION_DAYS=2555

