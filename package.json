{
  "name": "aaces",
  "private": true,
  "version": "1.0.0",
  "description": "AACES - Sistema de Gestión de Capacitaciones y Certificaciones",
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:typecheck": "npm --prefix frontend run type-check",
    "frontend:test": "npm --prefix frontend run test",
    "backend:dev": "cd backend && python3 -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "dev": "make dev",
    "up": "make up",
    "down": "make down",
    "build": "make build",
    "lint": "make lint",
    "typecheck": "make typecheck",
    "test": "make test"
  }
}
